# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
# Set DJANGO_DEBUG=False and DJANGO_ALLOWED_HOSTS to your real IP/domain for AWS deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=postgres to use Postgres (Docker/AWS). Leave unset for local SQLite.
DB_ENGINE=postgres
DB_NAME=symposium
DB_USER=symposium
DB_PASSWORD=symposium
DB_HOST=db
DB_PORT=5432

# LLM API key for the agent (Day 3+)
ANTHROPIC_API_KEY=
# or
OPENAI_API_KEY=

# n8n webhook URL for automation triggers (Day 5-6)
N8N_WEBHOOK_URL=
# Shared secret Django and n8n both use to authenticate the reindex callback
REINDEX_SECRET=
